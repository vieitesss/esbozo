{
  "name": "esbozo",
  "version": "0.0.0",
  "description": "A small canvas for hand-drawn diagrams, drawn by people and written by agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "esbozo": "dist/cli.js",
    "ez": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "skills"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.test.json",
    "test": "pnpm build && node --test test/*.test.ts",
    "test:docker": "node --test test/docker.ts",
    "e2e": "pnpm build && e2e run tests/editor.e2e.ts tests/drawing.e2e.ts tests/serve.e2e.ts",
    "e2e:agent": "pnpm build && e2e run tests/visual.e2e.ts",
    "e2e:shots": "pnpm build && e2e run tests/screenshots.e2e.ts",
    "serve:editor": "pnpm build && node dist/cli.js serve dist --port 4319"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "opentype.js": "^2.0.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@e2e-dev/core": "^0.24.0",
    "@e2e-dev/web": "^0.16.1",
    "@types/node": "^22.10.2",
    "ai": "^7.0.177",
    "e2e": "^0.24.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
