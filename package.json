{
  "name": "esbozo",
  "version": "0.0.0",
  "description": "A small canvas for hand-drawn diagrams, drawn by people and written by agents.",
  "type": "module",
  "bin": {
    "esbozo": "dist/cli.js",
    "ez": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.ts",
    "e2e": "pnpm build && playwright test",
    "serve:editor": "node scripts/serve.mjs dist 4319"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "opentype.js": "^2.0.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
